import pandas as pd
from sqlalchemy import create_engine

# Define your database connection string
# Replace 'your_username', 'your_password', 'your_host', 'your_database' with your actual database credentials
db_connection_str = 'mysql+pymysql://your_username:your_password@your_host/your_database'

# Create a SQLAlchemy engine
engine = create_engine(db_connection_str)

# Replace 'your_file.xlsx' with the path to your Excel file
excel_file = 'your_file.xlsx'

# Read the Excel file
xls = pd.ExcelFile(excel_file)

# Loop through all sheet names in the Excel file
for sheet_name in xls.sheet_names:
    try:
        # Read each sheet into a pandas DataFrame
        df = pd.read_excel(excel_file, sheet_name=sheet_name)
        
        # Replace spaces in column names with underscores (optional step)
        df.columns = df.columns.str.replace(' ', '_')
        
        # Convert the DataFrame to a SQL table
        df.to_sql(sheet_name, con=engine, if_exists='replace', index=False)
        print(f"Successfully imported {sheet_name} into the database.")
        
    except Exception as e:
        print(f"Error importing {sheet_name}: {e}")

# Dispose of the SQLAlchemy engine
engine.dispose()
